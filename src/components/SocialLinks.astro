---
import { site } from '../lib/data';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<ul class:list={['flex items-center gap-2', className]}>
  <li>
    <a
      href={site.socials.instagram}
      class="inline-flex size-11 items-center justify-center rounded-full border border-border text-text-muted transition duration-200 hover:border-primary hover:text-primary"
      aria-label="Instagram"
    >
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
      </svg>
    </a>
  </li>
  <li>
    <a
      href={site.socials.linkedin}
      class="inline-flex size-11 items-center justify-center rounded-full border border-border text-text-muted transition duration-200 hover:border-primary hover:text-primary"
      aria-label="LinkedIn"
    >
      <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <rect x="3" y="9" width="4" height="12" rx="0.5"></rect>
        <circle cx="5" cy="5" r="2"></circle>
        <path d="M10 9h3.8v1.7c.6-1 1.9-2 3.9-2 3.2 0 4.3 2 4.3 5.3V21h-4v-6.2c0-1.6-.4-2.7-1.9-2.7s-2.1 1.1-2.1 2.7V21h-4Z"></path>
      </svg>
    </a>
  </li>
</ul>
