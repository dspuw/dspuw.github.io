---
import { site } from '../lib/data';
import Container from './Container.astro';
import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="mt-auto bg-surface text-[0.8125rem] leading-relaxed text-text-muted">
  <Container class="py-14 sm:py-16">
    <div class="flex flex-col gap-10 border-b border-border pb-10 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <Logo class="w-28" />
        <SocialLinks class="mt-6" />
      </div>

      <nav aria-label="Footer">
        <ul class="grid grid-cols-2 gap-x-12 sm:grid-cols-3">
          {
            site.footerLinks.map((link) => (
              <li>
                <a href={link.href} class="inline-flex min-h-11 items-center text-text transition duration-200 hover:text-primary">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <section class="max-w-3xl py-8" aria-labelledby="land-acknowledgment">
      <h2 id="land-acknowledgment" class="font-sans text-[0.8125rem] font-semibold tracking-normal text-text">Land Acknowledgment</h2>
      <p class="mt-2">{site.landAcknowledgment}</p>
    </section>

    <p class="border-t border-border pt-6">Copyright &copy; {year} {site.name}.</p>
  </Container>
</footer>
