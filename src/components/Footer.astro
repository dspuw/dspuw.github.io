---
import { site } from '../lib/data';
import Container from './Container.astro';
import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border bg-surface">
  <Container class="grid gap-12 py-16 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Logo class="w-32" />
      <SocialLinks class="mt-6" />
    </div>

    <section class="lg:col-span-5" aria-labelledby="land-acknowledgment">
      <h2 id="land-acknowledgment" class="eyebrow">Land Acknowledgment</h2>
      <p class="mt-3 text-small text-text-muted">{site.landAcknowledgment}</p>
    </section>

    <nav class="lg:col-span-3" aria-label="Footer">
      <ul class="grid grid-cols-2 gap-x-6 lg:grid-cols-1">
        {
          site.footerLinks.map((link) => (
            <li>
              <a href={link.href} class="inline-flex min-h-11 items-center text-small text-text-muted transition duration-200 hover:text-primary">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>
  <div class="border-t border-border">
    <Container class="py-6">
      <p class="text-small text-text-muted">&copy; {year} {site.name}</p>
    </Container>
  </div>
</footer>
