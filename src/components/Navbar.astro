---
import { site } from '../lib/data';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import Button from './Button.astro';
import MembersPortalLink from './MembersPortalLink.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

// A section is current when the path is it or sits under it (Brothers covers its three views).
function isCurrent(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}
---

<header
  data-navbar
  class="group/nav sticky top-0 z-50 border-b border-transparent bg-glass backdrop-blur-xl backdrop-saturate-150 transition-[border-color] duration-200 data-[scrolled]:border-border"
>
  <nav aria-label="Main" class="mx-auto flex max-w-content items-center justify-between gap-4 px-5 py-3 transition-[padding] duration-200 group-data-[scrolled]/nav:py-1.5 sm:px-8 lg:px-12">
    <a href="/" class="shrink-0" aria-label="Delta Sigma Pi, Sigma Upsilon Chapter, home">
      <Logo class="w-24 transition-[width] duration-200 group-data-[scrolled]/nav:w-[5.25rem]" />
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        site.nav.map((item) =>
          item.children ? (
            <li class="relative" data-dropdown>
              <button
                type="button"
                class:list={[
                  'inline-flex min-h-11 items-center gap-1 rounded-button px-3 text-[0.8125rem] font-medium transition duration-200 hover:text-text',
                  isCurrent(item.href) ? 'text-text' : 'text-text-muted',
                ]}
                aria-expanded="false"
                aria-controls="brothers-menu"
                data-dropdown-button
              >
                {item.label}
                <svg class="size-4 transition-transform duration-200" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4Z" />
                </svg>
                {isCurrent(item.href) && <span class="absolute bottom-1 left-1/2 size-1 -translate-x-1/2 rounded-full bg-primary" aria-hidden="true" />}
              </button>
              {/* Padding instead of margin keeps the pointer inside the dropdown while it moves to the menu. */}
              <div
                class="invisible absolute left-1/2 top-full w-56 -translate-x-1/2 translate-y-1 pt-2 opacity-0 transition duration-200 data-[open]:visible data-[open]:translate-y-0 data-[open]:opacity-100"
                data-dropdown-menu
              >
              <ul id="brothers-menu" class="rounded-[18px] border border-border bg-bg p-2 shadow-lift dark:bg-surface">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class:list={[
                        'flex min-h-11 items-center rounded-xl px-3 text-small transition duration-200 hover:bg-surface-2',
                        path === child.href ? 'font-semibold text-primary' : 'text-text',
                      ]}
                      aria-current={path === child.href ? 'page' : undefined}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
              </div>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                class:list={[
                  'relative inline-flex min-h-11 items-center rounded-button px-3 text-[0.8125rem] font-medium transition duration-200 hover:text-text',
                  isCurrent(item.href) ? 'text-text' : 'text-text-muted',
                ]}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
                {isCurrent(item.href) && <span class="absolute bottom-1 left-1/2 size-1 -translate-x-1/2 rounded-full bg-primary" aria-hidden="true" />}
              </a>
            </li>
          ),
        )
      }
    </ul>

    <div class="flex items-center gap-1">
      <MembersPortalLink variant="nav" />
      <ThemeToggle />
      <Button href="/recruitment" class="min-h-9 px-4 text-[0.8125rem] whitespace-nowrap max-[379px]:hidden">Join Us</Button>
      <button
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-full text-text transition duration-200 hover:bg-surface lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-menu-button
      >
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path data-menu-icon="open" d="M4 7h16M4 12h16M4 17h16"></path>
          <path data-menu-icon="close" class="hidden" d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-border bg-bg lg:hidden" data-mobile-menu>
    <ul class="mx-auto max-w-content px-4 py-4 sm:px-6">
      {
        site.nav.map((item) => (
          <li>
            {item.children ? (
              <>
                <p class="px-3 pt-4 pb-1 text-small font-medium text-text-muted">{item.label}</p>
                <ul>
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class:list={[
                          'flex min-h-12 items-center rounded-2xl px-3 font-display text-[1.5rem] font-semibold tracking-[-0.02em]',
                          path === child.href ? 'bg-primary-soft text-primary' : 'text-text',
                        ]}
                        aria-current={path === child.href ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                  {site.membersPortal.url && (
                    <li class="mt-2">
                      <MembersPortalLink variant="mobile" />
                    </li>
                  )}
                </ul>
              </>
            ) : (
              <a
                href={item.href}
                class:list={[
                  'flex min-h-12 items-center rounded-2xl px-3 font-display text-[1.5rem] font-semibold tracking-[-0.02em]',
                  isCurrent(item.href) ? 'bg-primary-soft text-primary' : 'text-text',
                ]}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            )}
          </li>
        ))
      }
      <li class="pt-4">
        <Button href="/recruitment" class="w-full">Join Us</Button>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-navbar]');

  // Shrink the bar once the page has scrolled a little.
  if (header) {
    const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Brothers dropdown: opens on hover or click, closes on Escape or a click elsewhere.
  document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((dropdown) => {
    const button = dropdown.querySelector<HTMLButtonElement>('[data-dropdown-button]')!;
    const menu = dropdown.querySelector<HTMLElement>('[data-dropdown-menu]')!;
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      menu.toggleAttribute('data-open', open);
    };
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    dropdown.addEventListener('mouseenter', () => setOpen(true));
    dropdown.addEventListener('mouseleave', () => setOpen(false));
    dropdown.addEventListener('focusout', (event) => {
      if (!dropdown.contains(event.relatedTarget as Node)) setOpen(false);
    });
    dropdown.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setOpen(false);
        button.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (!dropdown.contains(event.target as Node)) setOpen(false);
    });
  });

  // Mobile menu.
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  if (menuButton && mobileMenu) {
    const setOpen = (open: boolean) => {
      menuButton.setAttribute('aria-expanded', String(open));
      menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      mobileMenu.classList.toggle('hidden', !open);
      menuButton.querySelector('[data-menu-icon="open"]')?.classList.toggle('hidden', open);
      menuButton.querySelector('[data-menu-icon="close"]')?.classList.toggle('hidden', !open);
    };
    menuButton.addEventListener('click', () => setOpen(menuButton.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        menuButton.focus();
      }
    });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
