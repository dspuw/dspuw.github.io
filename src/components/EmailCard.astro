---
// The chapter's main point of contact: one email address, shown large with a button to write to it.
import { site } from '../lib/data';
import Button from './Button.astro';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['min-w-0 rounded-card bg-surface p-8 sm:p-12', className]}>
  <p class="font-display text-[1.0625rem] font-semibold text-text-muted">Email us</p>
  <a
    href={`mailto:${site.email}`}
    class="mt-3 block font-display text-[1.625rem] leading-tight font-semibold tracking-[-0.025em] [overflow-wrap:anywhere] text-primary hover:underline sm:text-[2.25rem]"
  >
    {site.email}
  </a>
  <p class="mt-4 max-w-md text-body-lg text-text-muted">We'd love to hear from you.</p>
  <Button href={`mailto:${site.email}`} class="mt-8 min-h-12 px-7 text-body">Send an email</Button>
</div>
