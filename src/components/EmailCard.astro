---
// The chapter's main point of contact: one email address, shown large with a button to write to it.
import { site } from '../lib/data';

interface Props {
  class?: string;
  /** Solid purple card for light pages; the default is a subtle panel for purple sections. */
  solid?: boolean;
}
const { class: className, solid = false } = Astro.props;
---

<div
  class:list={[
    'min-w-0 rounded-card p-6 text-white sm:p-10',
    solid ? 'bg-brand shadow-lift' : 'border border-white/15 bg-white/5',
    className,
  ]}
>
  <p class="eyebrow text-accent-on-brand">Email us</p>
  <a
    href={`mailto:${site.email}`}
    class="mt-4 block font-display text-[1.5rem] leading-tight [overflow-wrap:anywhere] text-white underline-offset-4 hover:underline sm:text-[2rem]"
  >
    {site.email}
  </a>
  <p class="mt-4 max-w-md text-white/75">We'd love to hear from you.</p>
  <a
    href={`mailto:${site.email}`}
    class="mt-8 inline-flex min-h-12 items-center justify-center gap-2 rounded-button bg-white px-6 text-small font-semibold text-ink transition duration-200 ease-out-soft hover:-translate-y-0.5 hover:bg-accent-on-brand"
  >
    Send an email <span aria-hidden="true">&rarr;</span>
  </a>
</div>
