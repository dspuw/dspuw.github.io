---
import PageHeader from './PageHeader.astro';
import { site } from '../lib/data';
import MembersPortalLink from './MembersPortalLink.astro';

interface Props {
  eyebrow: string;
  title: string;
  /** Second line of the title, set in gray. */
  accent?: string;
}

const views = site.nav.find((item) => item.href === '/brothers')?.children ?? [];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<PageHeader {...Astro.props}>
  {Astro.slots.has('default') && <slot />}
  <div slot="below" class="reveal mt-10 flex flex-col items-center">
  <nav aria-label="Brothers" class="flex max-w-full justify-center">
    <ul class="inline-flex max-w-full gap-1 overflow-x-auto rounded-full bg-surface p-1">
      {
        views.map((view) => (
          <li>
            <a
              href={view.href}
              class:list={[
                'inline-flex min-h-11 items-center rounded-full px-5 text-small font-medium whitespace-nowrap transition duration-200',
                path === view.href ? 'bg-bg text-text shadow-soft dark:bg-surface-2' : 'text-text-muted hover:text-text',
              ]}
              aria-current={path === view.href ? 'page' : undefined}
            >
              {view.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <MembersPortalLink variant="pill" />
  </div>
</PageHeader>
