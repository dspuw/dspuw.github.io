---
// The saved choice is applied before paint by the inline script in BaseLayout.
---

<button
  type="button"
  data-theme-toggle
  class="inline-flex size-11 items-center justify-center rounded-full text-text-muted transition duration-200 hover:bg-surface-2 hover:text-text"
  aria-label="Switch to dark mode"
>
  <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
  <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script>
  function label(button: HTMLElement) {
    const dark = document.documentElement.dataset.theme === 'dark';
    button.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
  }

  document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((button) => {
    label(button);
    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Storage can be blocked; the toggle still works for this visit.
      }
      document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach(label);
    });
  });
</script>
