---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Container from './Container.astro';
import PlaceholderTag from './PlaceholderTag.astro';

interface Props {
  eyebrow: string;
  title: string;
  /** Second line of the title, set in italic brand purple. */
  accent?: string;
  photo: ImageMetadata;
  alt: string;
  /** Shows a placeholder tag on the photo until a newer one is added. */
  placeholder?: string;
}
const { eyebrow, title, accent, photo, alt, placeholder } = Astro.props;
---

<section class="pt-12 sm:pt-20" aria-labelledby="page-title">
  <Container>
    <p class="eyebrow reveal">{eyebrow}</p>
    <h1 id="page-title" class="reveal mt-5 text-[3rem] leading-[1] sm:text-display-lg lg:text-display-xl">
      {title}
      {accent && <span class="block text-primary italic">{accent}</span>}
    </h1>
    <slot />
    <figure class="reveal relative mt-12 overflow-hidden rounded-card sm:mt-16">
      <Picture
        src={photo}
        formats={['avif', 'webp']}
        widths={[640, 1024, 1600]}
        sizes="(min-width: 1200px) 1152px, 100vw"
        alt={alt}
        class="aspect-[4/3] w-full object-cover sm:aspect-[21/8]"
        loading="eager"
        fetchpriority="high"
      />
      {placeholder && <PlaceholderTag class="absolute top-4 left-4">{placeholder}</PlaceholderTag>}
    </figure>
  </Container>
</section>
