---
// Page opener for pages that lead with a photo: a centered headline, then the photo as a large rounded panel.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Container from './Container.astro';
import PlaceholderTag from './PlaceholderTag.astro';

interface Props {
  eyebrow: string;
  title: string;
  /** Second line of the title, set in gray. */
  accent?: string;
  /** Short line under the title. */
  lead?: string;
  photo: ImageMetadata;
  alt: string;
  /** Which part of the photo stays in view when it is cropped, as a CSS object-position. */
  focus?: string;
  /** Aspect ratio classes for the photo, for portrait photos that need a taller crop. */
  aspect?: string;
  /** Shows a placeholder tag on the photo until a newer one is added. */
  placeholder?: string;
}
const { eyebrow, title, accent, lead, photo, alt, focus = 'center', aspect = 'aspect-[4/3] sm:aspect-[16/9] lg:aspect-[21/9]', placeholder } = Astro.props;
---

<section aria-labelledby="page-title" class="pt-16 sm:pt-24">
  <Container class="text-center">
    <p class="eyebrow reveal">{eyebrow}</p>
    <h1 id="page-title" class="reveal mx-auto mt-3 max-w-5xl text-[3rem] leading-[1.02] sm:text-display-lg lg:text-display-xl">
      {title}
      {accent && <span class="block text-text-muted">{accent}</span>}
    </h1>
    {lead && <p class="reveal mx-auto mt-6 max-w-2xl text-body-lg text-text-muted sm:text-[1.375rem] sm:leading-[1.5]">{lead}</p>}
  </Container>
  <Container class="mt-12 sm:mt-16">
    <div class="reveal relative overflow-hidden rounded-card bg-surface">
      <Picture
        src={photo}
        formats={['avif', 'webp']}
        widths={[640, 1024, 1600, 2000]}
        sizes="(min-width: 1520px) 1424px, 100vw"
        alt={alt}
        class:list={[aspect, 'w-full object-cover']}
        style={`object-position: ${focus}`}
        loading="eager"
        fetchpriority="high"
      />
      {placeholder && (
        <div class="absolute top-4 left-4">
          <PlaceholderTag>{placeholder}</PlaceholderTag>
        </div>
      )}
    </div>
  </Container>
  {Astro.slots.has('default') && (
    <Container>
      <slot />
    </Container>
  )}
</section>
