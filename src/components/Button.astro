---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'text';
  class?: string;
}
const { href, variant = 'primary', class: className } = Astro.props;

const styles = {
  primary: 'px-6 bg-primary text-on-primary hover:bg-primary-hover',
  secondary: 'px-6 bg-surface-2 text-text hover:bg-border',
  text: 'text-primary underline-offset-4 hover:underline',
};
---

<a
  href={href}
  class:list={[
    'inline-flex min-h-11 items-center justify-center gap-1.5 rounded-button text-[0.9375rem] font-medium transition duration-200 ease-out-soft active:scale-[0.98]',
    styles[variant],
    className,
  ]}
>
  <slot />
</a>
