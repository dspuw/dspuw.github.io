---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import PageHero from '../components/PageHero.astro';
import { about } from '../lib/data';
import heroPhoto from '../assets/images/about/chi-class-on-campus-steps.jpg';
import formalPhoto from '../assets/images/about/brothers-at-formal.jpg';
import portraitPhoto from '../assets/images/about/brothers-formal-portrait.jpg';
import professionalism from '../assets/images/about/pillar-professionalism.jpg';
import communityService from '../assets/images/about/pillar-community-service.jpg';
import scholarship from '../assets/images/about/pillar-scholarship.jpg';
import brotherhood from '../assets/images/about/pillar-brotherhood.jpg';

const pillarPhotos = {
  Professionalism: { src: professionalism, alt: 'Brothers in a professional development session around a conference table' },
  'Community Service': { src: communityService, alt: 'A hand-drawn "DSP Walks for a Cure" sign at a community service event' },
  Scholarship: { src: scholarship, alt: 'Brothers meeting with a professional around a table in a bright room' },
  Brotherhood: { src: brotherhood, alt: 'Three brothers smiling with their arms around each other' },
} as const;
---

<BaseLayout title="About" description={about.story.paragraphs[0]}>
  <PageHero
    eyebrow="Sigma Upsilon Chapter"
    title={about.hero.title}
    photo={heroPhoto}
    alt="The Chi pledge class in business attire on the steps of a campus building"
    placeholder="Placeholder photo: swap in a newer chapter photo"
  />

  <!-- Our Story -->
  <section class="py-24 sm:py-32" aria-labelledby="story-title">
    <Container class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow reveal">01</p>
        <h2 id="story-title" class="reveal mt-4 text-[2.5rem] leading-[1.05] sm:text-h2">{about.story.eyebrow}</h2>
      </div>
      <div class="lg:col-span-8">
        <p class="reveal font-display text-[1.5rem] leading-[1.4] sm:text-[1.875rem]">{about.story.paragraphs[0]}</p>
        {about.story.paragraphs.slice(1).map((p) => <p class="reveal mt-8 max-w-2xl text-body-lg text-text-muted">{p}</p>)}
        <div class="reveal mt-12 grid grid-cols-5 gap-4">
          <div class="col-span-3">
          <Picture
            src={formalPhoto}
            formats={['avif', 'webp']}
            widths={[480, 960]}
            sizes="(min-width: 1024px) 460px, 60vw"
            alt="A group of brothers dressed up and smiling together at an evening event"
            class="aspect-[4/3] size-full rounded-card object-cover"
          />
          </div>
          <div class="col-span-2">
          <Picture
            src={portraitPhoto}
            formats={['avif', 'webp']}
            widths={[320, 640]}
            sizes="(min-width: 1024px) 300px, 40vw"
            alt="Six brothers posing together in formal wear"
            class="aspect-[3/4] size-full rounded-card object-cover sm:aspect-auto"
          />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Our Purpose -->
  <section class="border-y border-border bg-surface py-24 sm:py-32" aria-labelledby="purpose-title">
    <Container>
      <p class="eyebrow reveal">02</p>
      <h2 id="purpose-title" class="reveal mt-4 text-[2.5rem] leading-[1.05] sm:text-h2">{about.purpose.eyebrow}</h2>
      <div class="mt-12 grid gap-12 md:grid-cols-2 md:gap-16">
        {
          about.purpose.items.map((item) => (
            <article class="reveal border-t border-accent pt-8">
              <h3 class="text-[1.75rem] leading-[1.2]">{item.heading}</h3>
              <p class="mt-4 text-body-lg text-text-muted">{item.text}</p>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Our Pillars -->
  <section class="py-24 sm:py-32" aria-labelledby="pillars-title">
    <Container>
      <p class="eyebrow reveal">03</p>
      <h2 id="pillars-title" class="reveal mt-4 text-[2.5rem] leading-[1.05] sm:text-h2">{about.pillars.eyebrow}</h2>
      <div class="mt-16 space-y-20 sm:space-y-28">
        {
          about.pillars.items.map((pillar, index) => {
            const photo = pillarPhotos[pillar.name as keyof typeof pillarPhotos];
            return (
              <article class="grid items-center gap-8 lg:grid-cols-12 lg:gap-12">
                <div class:list={['reveal lg:col-span-6', index % 2 === 1 && 'lg:order-2 lg:col-start-7']}>
                  <Picture
                    src={photo.src}
                    formats={['avif', 'webp']}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 1024px) 576px, 100vw"
                    alt={photo.alt}
                    class="aspect-[4/3] w-full rounded-card object-cover"
                  />
                </div>
                <div class:list={['reveal lg:col-span-5', index % 2 === 1 ? 'lg:order-1 lg:col-start-1' : 'lg:col-start-8']}>
                  <p class="font-display text-[1.25rem] text-accent-text italic">{`0${index + 1}`}</p>
                  <h3 class="mt-2 text-[2rem] leading-[1.1] sm:text-[2.5rem]">{pillar.name}</h3>
                  <p class="mt-5 text-body-lg text-text-muted">{pillar.text}</p>
                </div>
              </article>
            );
          })
        }
      </div>
    </Container>
  </section>

  <section class="bg-brand text-white">
    <Container class="flex flex-col items-start gap-6 py-20 sm:flex-row sm:items-center sm:justify-between">
      <h2 class="text-[2.25rem] leading-[1.05] sm:text-h2">Join Us</h2>
      <a
        href="/recruitment"
        class="inline-flex min-h-12 items-center rounded-button bg-white px-6 text-small font-semibold text-ink transition duration-200 hover:-translate-y-0.5 hover:bg-accent-on-brand"
      >
        Recruitment <span aria-hidden="true" class="ml-2">&rarr;</span>
      </a>
    </Container>
  </section>
</BaseLayout>
