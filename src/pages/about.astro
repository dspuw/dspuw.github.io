---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { about } from '../lib/data';
import heroPhoto from '../assets/images/about/chapter-photo-fall-2025.jpg';
import leadPhoto from '../assets/images/about/brothers-conference-business-attire.jpg';
import loungePhoto from '../assets/images/about/brothers-conference-lounge.jpg';
---

<BaseLayout title="About" description={about.story.paragraphs[0]}>
  <PageHero
    eyebrow="Sigma Upsilon Chapter"
    title={about.hero.title}
    photo={heroPhoto}
    alt="The whole chapter in business attire in a lecture hall, with the Delta Sigma Pi crest on the screen behind them"
    focus="50% 45%"
  />

  <!-- Our Story -->
  <section class="py-24 sm:py-32" aria-labelledby="story-title">
    <Container>
      <div class="mx-auto max-w-5xl">
        <h2 id="story-title" class="eyebrow reveal">{about.story.eyebrow}</h2>
        <p class="reveal mt-5 font-display text-[1.625rem] leading-[1.3] font-semibold tracking-[-0.025em] sm:text-[2.5rem] sm:leading-[1.2]">
          {about.story.paragraphs[0]}
        </p>
        {about.story.paragraphs.slice(1).map((p) => <p class="reveal mt-8 max-w-3xl text-body-lg text-text-muted sm:text-[1.3125rem]">{p}</p>)}
      </div>

      <div class="mt-16 grid gap-4 sm:mt-20 sm:grid-cols-5 sm:gap-5">
        <div class="reveal overflow-hidden rounded-card bg-surface sm:col-span-3">
          <Picture
            src={leadPhoto}
            formats={['avif', 'webp']}
            widths={[480, 960, 1400]}
            sizes="(min-width: 640px) 60vw, 100vw"
            alt="Four brothers in business attire with LEAD conference lanyards on the steps of a hotel lobby"
            class="aspect-[4/3] size-full object-cover object-[50%_70%]"
          />
        </div>
        <div class="reveal overflow-hidden rounded-card bg-surface sm:col-span-2">
          <Picture
            src={loungePhoto}
            formats={['avif', 'webp']}
            widths={[400, 800, 1000]}
            sizes="(min-width: 640px) 40vw, 100vw"
            alt="Four brothers in business attire with LEAD conference lanyards seated on a lounge sofa"
            class="aspect-[4/3] size-full object-cover object-[50%_65%] sm:aspect-auto"
          />
        </div>
      </div>
    </Container>
  </section>

  <!-- Our Purpose -->
  <section class="bg-surface py-24 sm:py-32" aria-labelledby="purpose-title">
    <Container>
      <h2 id="purpose-title" class="reveal text-center text-[2.5rem] leading-[1.05] sm:text-h2 lg:text-display-lg">{about.purpose.eyebrow}</h2>
      <div class="mt-12 grid gap-4 sm:mt-16 sm:gap-5 md:grid-cols-2">
        {
          about.purpose.items.map((item) => (
            <article class="reveal rounded-card bg-bg p-8 sm:p-12">
              <h3 class="text-[1.75rem] leading-[1.15] sm:text-[2.25rem]">{item.heading}</h3>
              <p class="mt-5 text-body-lg text-text-muted">{item.text}</p>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Our Pillars -->
  <section class="py-24 sm:py-32" aria-labelledby="pillars-title">
    <Container>
      <h2 id="pillars-title" class="reveal text-center text-[2.5rem] leading-[1.05] sm:text-h2 lg:text-display-lg">{about.pillars.eyebrow}</h2>
      <div class="mt-12 grid gap-4 sm:mt-16 sm:grid-cols-2 sm:gap-5 xl:grid-cols-4">
        {
          about.pillars.items.map((pillar, index) => (
            <article class="reveal flex flex-col rounded-card bg-surface p-8 sm:p-10">
              <p class="font-display text-[4rem] leading-none font-semibold tracking-[-0.05em] text-primary/25 tabular-nums" aria-hidden="true">
                {index + 1}
              </p>
              <h3 class="mt-10 text-[1.75rem] leading-[1.15]">{pillar.name}</h3>
              <p class="mt-4 text-body text-text-muted">{pillar.text}</p>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="pb-24 sm:pb-32" aria-labelledby="join-title">
    <Container class="text-center">
      <h2 id="join-title" class="reveal text-[2.5rem] leading-[1.05] sm:text-h2 lg:text-display-lg">Join Us</h2>
      <div class="reveal mt-8">
        <Button href="/recruitment" class="min-h-12 px-7 text-body">Recruitment</Button>
      </div>
    </Container>
  </section>
</BaseLayout>
