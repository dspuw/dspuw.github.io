---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import SocialLinks from '../components/SocialLinks.astro';
import StatCounter from '../components/StatCounter';
import EmailCard from '../components/EmailCard.astro';
import AlumniCompanies from '../components/AlumniCompanies.astro';
import { home, site } from '../lib/data';
import heroPhoto from '../assets/images/home/chapter-group-with-letters-banner.jpg';
import brothersPhoto from '../assets/images/home/brothers-chapter-crest.jpg';
import joinPhoto from '../assets/images/home/brothers-speaker-event.jpg';

const cards = [
  { ...home.whoWeAre, photo: brothersPhoto, alt: 'Brothers in business attire in front of the Delta Sigma Pi crest' },
  { ...home.joinUs, photo: joinPhoto, alt: 'Brothers and guests gathered at the front of a lecture hall after a speaker event' },
];
---

<BaseLayout>
  <!-- Hero: on phones the photo sits behind the title; on desktop the title panel and photo split the width -->
  <section class="relative isolate overflow-hidden bg-brand text-white lg:grid lg:min-h-[calc(100svh-7rem)] lg:grid-cols-2" aria-labelledby="hero-title">
    <div class="absolute inset-0 -z-10 lg:relative lg:inset-auto lg:z-0 lg:order-2">
      <Picture
        src={heroPhoto}
        formats={['avif', 'webp']}
        widths={[640, 1024, 1536]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        alt="Sigma Upsilon brothers in business attire filling a lecture hall, with the front row holding a purple and gold Delta Sigma Pi banner"
        class="absolute inset-0 size-full object-cover object-[50%_68%]"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink/95 via-ink/55 to-ink/10 lg:hidden" aria-hidden="true"></div>
    </div>

    <div class="flex min-h-[calc(100svh-7rem)] items-end px-5 pt-40 pb-12 sm:px-8 sm:pb-16 lg:min-h-0 lg:items-center lg:py-20 lg:pr-16 lg:pl-[max(3rem,calc((100vw-1520px)/2+3rem))]">
      <div class="max-w-2xl">
        <p class="eyebrow reveal text-accent-on-brand">University of Washington</p>
        <h1 id="hero-title" class="reveal mt-5 text-[3.25rem] leading-[0.98] sm:text-display-xl">
          {home.hero.title}
          <span class="block text-accent-on-brand italic">{home.hero.subtitle}</span>
        </h1>
        <p class="reveal mt-6 max-w-lg text-body-lg text-white/85">{home.hero.tagline}</p>
        <div class="reveal mt-8 flex flex-wrap gap-3">
          <a
            href={home.joinUs.link.href}
            class="inline-flex min-h-12 items-center justify-center rounded-button bg-white px-6 text-small font-semibold text-ink shadow-soft transition duration-200 ease-out-soft hover:-translate-y-0.5 hover:bg-accent-on-brand"
          >
            {home.joinUs.link.label}
          </a>
          <a
            href={home.about.link.href}
            class="inline-flex min-h-12 items-center justify-center rounded-button border border-white/40 px-6 text-small font-semibold text-white transition duration-200 ease-out-soft hover:-translate-y-0.5 hover:border-white hover:bg-white/10"
          >
            {home.about.link.label}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- About DSP, with the chapter facts beside it -->
  <section class="py-20 sm:py-24" aria-labelledby="about-title">
    <Container class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow reveal">01 · {home.about.heading}</p>
        <h2 id="about-title" class="sr-only">{home.about.heading}</h2>
        <p class="reveal mt-6 font-display text-[1.5rem] leading-[1.4] text-text sm:text-[2rem] sm:leading-[1.35]">
          {home.about.paragraphs[0]}
        </p>
        <Button href={home.about.link.href} variant="text" class="reveal mt-6">
          {home.about.link.label}
          <span aria-hidden="true">&rarr;</span>
        </Button>
      </div>

      <aside class="reveal self-start rounded-card bg-surface p-8 sm:p-10 lg:col-span-5" aria-label="Chapter facts">
        <p class="eyebrow">Sigma Upsilon Chapter</p>
        {home.about.paragraphs.slice(1).map((paragraph) => <p class="mt-4 text-body-lg text-text-muted">{paragraph}</p>)}
        <ul class="mt-8 grid grid-cols-2 gap-6 border-t border-border pt-8">
          {
            site.stats.map((stat) => (
              <li>
                <StatCounter
                  client:visible
                  value={stat.value}
                  suffix={stat.suffix}
                  label={stat.label}
                  from={stat.value > 1000 ? stat.value - 40 : 0}
                />
              </li>
            ))
          }
        </ul>
      </aside>
    </Container>
  </section>

  <!-- Who We Are / Join Us -->
  <section class="pb-20 sm:pb-24" aria-label="Explore the chapter">
    <Container class="grid gap-6 md:grid-cols-2">
      {
        cards.map((card, index) => (
          <a
            href={card.link.href}
            class="group reveal relative isolate flex min-h-[28rem] flex-col justify-end overflow-hidden rounded-card p-8 text-white sm:min-h-[34rem] sm:p-10"
          >
            <Picture
              src={card.photo}
              formats={['avif', 'webp']}
              widths={[480, 800, 1200]}
              sizes="(min-width: 768px) 50vw, 100vw"
              alt={card.alt}
              class="absolute inset-0 -z-20 size-full object-cover transition-transform duration-300 ease-out-soft group-hover:scale-[1.03]"
            />
            <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/90 via-ink/30 to-transparent" aria-hidden="true" />
            <p class="eyebrow text-accent-on-brand">{`0${index + 2}`}</p>
            <h2 class="mt-3 text-[2.25rem] leading-[1.05] sm:text-h2">{card.heading}</h2>
            <p class="mt-3 max-w-sm text-body-lg text-white/80">{card.text}</p>
            <span class="mt-6 inline-flex items-center gap-2 text-small font-semibold">
              {card.link.label}
              <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">
                &rarr;
              </span>
            </span>
          </a>
        ))
      }
    </Container>
  </section>

  <AlumniCompanies />

  <!-- Contact Us -->
  <section id="contact" class="bg-brand text-white" aria-labelledby="contact-title">
    <Container class="grid gap-12 py-20 sm:py-24 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow reveal text-accent-on-brand">05</p>
        <h2 id="contact-title" class="reveal mt-4 text-[2.5rem] leading-[1.05] sm:text-h2">{home.contact.heading}</h2>
        <p class="reveal mt-6 max-w-md text-body-lg text-white/80">{home.contact.text}</p>
        <SocialLinks class="reveal mt-8 [&_a]:border-white/25 [&_a]:text-white [&_a:hover]:border-accent-on-brand [&_a:hover]:text-accent-on-brand" />
      </div>
      <EmailCard class="reveal lg:col-span-6 lg:col-start-7 lg:self-center" />
    </Container>
  </section>
</BaseLayout>
