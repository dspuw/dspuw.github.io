---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import SocialLinks from '../components/SocialLinks.astro';
import StatCounter from '../components/StatCounter';
import AlumniCompanies from '../components/AlumniCompanies.astro';
import { home, site } from '../lib/data';
import heroPhoto from '../assets/images/home/chapter-group-with-letters-banner.jpg';
import brothersPhoto from '../assets/images/home/brothers-chapter-crest-fall-2025.jpg';
import joinPhoto from '../assets/images/home/brothers-speaker-event.jpg';

const [founded, brothers] = site.stats;
---

<BaseLayout>
  <!-- Hero: a centered headline over a large rounded photo -->
  <section class="pt-16 sm:pt-24" aria-labelledby="hero-title">
    <Container class="text-center">
      <p class="eyebrow reveal">University of Washington</p>
      <h1 id="hero-title" class="reveal mx-auto mt-3 max-w-5xl text-[3.5rem] leading-[1] sm:text-display-xl lg:text-[8rem]">
        {home.hero.title}
      </h1>
      <p class="reveal mt-3 font-display text-[1.75rem] font-semibold tracking-[-0.03em] text-text-muted sm:text-[2.75rem]">
        {home.hero.subtitle}
      </p>
      <p class="reveal mx-auto mt-6 max-w-xl text-body-lg text-text-muted sm:text-[1.3125rem]">{home.hero.tagline}</p>
      <div class="reveal mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
        <Button href={home.joinUs.link.href} class="min-h-12 px-7 text-body">Join Us</Button>
        <a href={home.about.link.href} class="inline-flex min-h-12 items-center gap-1 text-body font-medium text-primary hover:underline">
          {home.about.link.label} <span aria-hidden="true">&rsaquo;</span>
        </a>
      </div>
    </Container>

    <Container class="mt-14 sm:mt-20">
      <div class="reveal overflow-hidden rounded-card bg-surface">
        <Picture
          src={heroPhoto}
          formats={['avif', 'webp']}
          widths={[640, 1024, 1600, 2000]}
          sizes="(min-width: 1520px) 1424px, 100vw"
          alt="Sigma Upsilon brothers in business attire filling a lecture hall, with the front row holding a purple and gold Delta Sigma Pi banner"
          class="aspect-[4/3] w-full object-cover object-[50%_60%] sm:aspect-[16/9] lg:aspect-[2/1]"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </Container>
  </section>

  <!-- About DSP, as one large statement -->
  <section class="py-24 sm:py-32" aria-labelledby="about-title">
    <Container>
      <div class="mx-auto max-w-5xl">
        <h2 id="about-title" class="eyebrow reveal font-semibold tracking-[-0.01em]">{home.about.heading}</h2>
        <p class="reveal mt-5 font-display text-[1.625rem] leading-[1.3] font-semibold tracking-[-0.025em] text-text sm:text-[2.5rem] sm:leading-[1.2]">
          {home.about.paragraphs[0]}
        </p>
        <a href={home.about.link.href} class="reveal mt-8 inline-flex min-h-11 items-center gap-1 text-body-lg font-medium text-primary hover:underline">
          {home.about.link.label} <span aria-hidden="true">&rsaquo;</span>
        </a>
      </div>
    </Container>
  </section>

  <!-- The chapter at a glance: photo tiles, facts and the chapter story -->
  <section class="pb-24 sm:pb-32" aria-labelledby="chapter-title">
    <Container>
      <h2 id="chapter-title" class="reveal text-center text-[2.5rem] leading-[1.05] sm:text-h2 lg:text-display-lg">
        The Sigma Upsilon Chapter.
      </h2>

      <div class="mt-12 grid gap-4 sm:mt-16 sm:gap-5 lg:grid-cols-3 lg:grid-rows-[minmax(17rem,auto)_minmax(17rem,auto)_minmax(26rem,auto)]">
        <a
          href={home.whoWeAre.link.href}
          class="group reveal relative isolate flex min-h-[30rem] flex-col justify-end gap-6 overflow-hidden rounded-card p-8 text-white sm:p-10 lg:col-span-2 lg:row-span-2"
        >
          <Picture
            src={brothersPhoto}
            formats={['avif', 'webp']}
            widths={[640, 1024, 1600]}
            sizes="(min-width: 1024px) 66vw, 100vw"
            alt="Brothers in business attire in front of the Delta Sigma Pi crest projected on a lecture hall screen"
            class="absolute inset-0 -z-20 size-full object-cover object-[50%_30%] transition-transform duration-300 ease-out-soft group-hover:scale-[1.02]"
          />
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/85 via-ink/35 to-transparent" aria-hidden="true"></div>
          <div>
            <p class="font-display text-[1.0625rem] font-semibold text-white/80">{home.whoWeAre.heading}</p>
            <p class="mt-2 max-w-md font-display text-[2rem] leading-[1.1] font-semibold tracking-[-0.03em] sm:text-[2.75rem]">
              {home.whoWeAre.text}
            </p>
          </div>
          <span class="inline-flex items-center gap-1 self-start rounded-full bg-white/15 px-5 py-2.5 text-small font-medium backdrop-blur-md transition duration-200 group-hover:bg-white/25">
            {home.whoWeAre.link.label} <span aria-hidden="true">&rsaquo;</span>
          </span>
        </a>

        <div class="reveal flex flex-col justify-end rounded-card bg-surface p-8 sm:p-10">
          {founded && <StatCounter client:visible value={founded.value} suffix={founded.suffix} label={founded.label} from={founded.value - 40} />}
        </div>
        <div class="reveal flex flex-col justify-end rounded-card bg-surface p-8 sm:p-10">
          {brothers && <StatCounter client:visible value={brothers.value} suffix={brothers.suffix} label={brothers.label} />}
        </div>

        <div class="reveal flex flex-col justify-between gap-8 rounded-card bg-surface p-8 sm:p-10">
          <p class="font-display text-[1.0625rem] font-semibold text-primary">Since 2012</p>
          <p class="text-body-lg text-text-muted">{home.about.paragraphs[1]}</p>
        </div>

        <a
          href={home.joinUs.link.href}
          class="group reveal relative isolate flex min-h-[26rem] flex-col justify-between overflow-hidden rounded-card p-8 text-white sm:p-10 lg:col-span-2"
        >
          <Picture
            src={joinPhoto}
            formats={['avif', 'webp']}
            widths={[640, 1024, 1600]}
            sizes="(min-width: 1024px) 66vw, 100vw"
            alt="Brothers and guests gathered at the front of a lecture hall after a speaker event"
            class="absolute inset-0 -z-20 size-full object-cover object-[50%_55%] transition-transform duration-300 ease-out-soft group-hover:scale-[1.02]"
          />
          <div class="absolute inset-0 -z-10 bg-gradient-to-b from-ink/65 via-ink/10 to-ink/60" aria-hidden="true"></div>
          <div>
            <p class="font-display text-[1.0625rem] font-semibold text-white/80">{home.joinUs.heading}</p>
            <p class="mt-2 max-w-md font-display text-[2rem] leading-[1.1] font-semibold tracking-[-0.03em] sm:text-[2.75rem]">
              {home.joinUs.text}
            </p>
          </div>
          <span class="inline-flex items-center gap-1 self-start rounded-full bg-white px-5 py-2.5 text-small font-medium text-ink transition duration-200 group-hover:bg-white/90">
            {home.joinUs.link.label} <span aria-hidden="true">&rsaquo;</span>
          </span>
        </a>
      </div>
    </Container>
  </section>

  <AlumniCompanies />

  <!-- Contact Us -->
  <section id="contact" class="py-24 sm:py-32" aria-labelledby="contact-title">
    <Container>
      <div class="reveal rounded-card bg-surface px-6 py-16 text-center sm:px-12 sm:py-24">
        <h2 id="contact-title" class="text-[2.5rem] leading-[1.05] sm:text-h2 lg:text-display-lg">{home.contact.heading}</h2>
        <p class="mx-auto mt-5 max-w-xl text-body-lg text-text-muted sm:text-[1.3125rem]">{home.contact.text}</p>
        <a
          href={`mailto:${site.email}`}
          class="mt-8 inline-block font-display text-[1.375rem] font-semibold tracking-[-0.02em] [overflow-wrap:anywhere] text-primary hover:underline sm:text-[2rem]"
        >
          {site.email}
        </a>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <Button href={`mailto:${site.email}`} class="min-h-12 px-7 text-body">Send an email</Button>
          <SocialLinks />
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
