---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import PlaceholderTag from '../components/PlaceholderTag.astro';
import SocialLinks from '../components/SocialLinks.astro';
import StatCounter from '../components/StatCounter';
import EmailCard from '../components/EmailCard.astro';
import AlumniCompanies from '../components/AlumniCompanies.astro';
import { home, site } from '../lib/data';
import heroPhoto from '../assets/images/home/chapter-group-with-letters-banner.jpg';
import brothersPhoto from '../assets/images/home/brothers-paccar-hall.jpg';
import joinPhoto from '../assets/images/home/brothers-formal-night.jpg';

const cards = [
  { ...home.whoWeAre, photo: brothersPhoto, alt: 'Brothers in business attire gathered outside PACCAR Hall' },
  { ...home.joinUs, photo: joinPhoto, alt: 'Brothers in formal wear smiling together at a chapter event' },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="pt-12 sm:pt-20" aria-labelledby="hero-title">
    <Container class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-6">
        <p class="eyebrow reveal">University of Washington</p>
        <h1 id="hero-title" class="reveal mt-5 text-[3.5rem] leading-[0.98] sm:text-display-xl">
          {home.hero.title}
          <span class="block text-primary italic">{home.hero.subtitle}</span>
        </h1>
        <p class="reveal mt-8 max-w-md text-body-lg text-text-muted">{home.hero.tagline}</p>
        <div class="reveal mt-6 flex flex-wrap gap-3">
          <Button href={home.joinUs.link.href}>{home.joinUs.link.label}</Button>
          <Button href={home.about.link.href} variant="secondary">{home.about.link.label}</Button>
        </div>

        <ul class="mt-12 grid grid-cols-3 gap-4 border-t border-border pt-8 sm:gap-8">
          {
            site.stats.map((stat) => (
              <li class="reveal">
                <StatCounter
                  client:visible
                  value={stat.value}
                  suffix={stat.suffix}
                  label={stat.label}
                  from={stat.value > 1000 ? stat.value - 40 : 0}
                />
              </li>
            ))
          }
        </ul>
      </div>

      <figure class="reveal overflow-hidden rounded-card lg:col-span-6">
        <Picture
          src={heroPhoto}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200, 1536]}
          sizes="(min-width: 1200px) 564px, (min-width: 1024px) 46vw, 100vw"
          alt="Sigma Upsilon brothers in business attire filling a lecture hall, with the front row holding a purple and gold Delta Sigma Pi banner"
          class="aspect-[4/5] w-full object-cover object-[50%_62%]"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </Container>
  </section>

  <!-- About DSP -->
  <section class="py-24 sm:py-32" aria-labelledby="about-title">
    <Container class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow reveal">01</p>
        <h2 id="about-title" class="reveal mt-4 text-[2.5rem] leading-[1.05] sm:text-h2">{home.about.heading}</h2>
      </div>
      <div class="lg:col-span-8">
        <p class="reveal font-display text-[1.5rem] leading-[1.4] text-text sm:text-[1.875rem]">
          {home.about.paragraphs[0]}
        </p>
        {
          home.about.paragraphs.slice(1).map((paragraph) => (
            <p class="reveal mt-8 max-w-2xl text-body-lg text-text-muted">{paragraph}</p>
          ))
        }
        <Button href={home.about.link.href} variant="text" class="reveal mt-6">
          {home.about.link.label}
          <span aria-hidden="true">&rarr;</span>
        </Button>
      </div>
    </Container>
  </section>

  <!-- Who We Are / Join Us -->
  <section class="pb-24 sm:pb-32" aria-label="Explore the chapter">
    <Container class="grid gap-6 md:grid-cols-2">
      {
        cards.map((card, index) => (
          <a
            href={card.link.href}
            class="group reveal relative isolate flex min-h-[28rem] flex-col justify-end overflow-hidden rounded-card p-8 text-white sm:min-h-[34rem] sm:p-10"
          >
            <Picture
              src={card.photo}
              formats={['avif', 'webp']}
              widths={[480, 800, 1200]}
              sizes="(min-width: 768px) 50vw, 100vw"
              alt={card.alt}
              class="absolute inset-0 -z-20 size-full object-cover transition-transform duration-300 ease-out-soft group-hover:scale-[1.03]"
            />
            <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/90 via-ink/30 to-transparent" aria-hidden="true" />
            <PlaceholderTag class="absolute top-4 left-4">Placeholder photo</PlaceholderTag>
            <p class="eyebrow text-accent-on-brand">{`0${index + 2}`}</p>
            <h2 class="mt-3 text-[2.25rem] leading-[1.05] sm:text-h2">{card.heading}</h2>
            <p class="mt-3 max-w-sm text-body-lg text-white/80">{card.text}</p>
            <span class="mt-6 inline-flex items-center gap-2 text-small font-semibold">
              {card.link.label}
              <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">
                &rarr;
              </span>
            </span>
          </a>
        ))
      }
    </Container>
  </section>

  <AlumniCompanies />

  <!-- Contact Us -->
  <section id="contact" class="bg-brand text-white" aria-labelledby="contact-title">
    <Container class="grid gap-12 py-24 sm:py-32 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow reveal text-accent-on-brand">05</p>
        <h2 id="contact-title" class="reveal mt-4 text-[2.5rem] leading-[1.05] sm:text-h2">{home.contact.heading}</h2>
        <p class="reveal mt-6 max-w-md text-body-lg text-white/80">{home.contact.text}</p>
        <SocialLinks class="reveal mt-8 [&_a]:border-white/25 [&_a]:text-white [&_a:hover]:border-accent-on-brand [&_a:hover]:text-accent-on-brand" />
      </div>
      <EmailCard class="reveal lg:col-span-6 lg:col-start-7 lg:self-center" />
    </Container>
  </section>
</BaseLayout>
