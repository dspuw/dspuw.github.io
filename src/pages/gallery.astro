---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import PageHeader from '../components/PageHeader.astro';
import Gallery from '../components/Gallery';
import { gallery } from '../lib/data';
import { galleryPhotos } from '../lib/gallery';

const photos = await galleryPhotos();
---

<BaseLayout title="Gallery" description="Photos from Sigma Upsilon professional events, pledge classes, banquets and brotherhood events.">
  <PageHeader eyebrow="Gallery" title="The Highlights" />

  <section class="pb-20 sm:pb-24" aria-label="Photos">
    <Container>
      <Gallery client:visible photos={photos} categories={gallery.categories} />
    </Container>
  </section>
</BaseLayout>
